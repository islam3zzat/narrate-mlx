    },
    {
      "id": "s05",
      "narration": "الْعَمِيلُ يَطْلُبُ مِنَ الْبَوَّابَةِ، وَالْبَوَّابَةُ تُحَوِّلُ إِلَى الْخَدَمَةِ.",
      "visual": {
        "type": "flow",
        "heading": "سلسلة",
        "nodes": [
          {
            "label": "العميل",
