  "scenes": [
    {
      "id": "s01",
      "narration": "هَذَا اخْتِبَارٌ قَصِيرٌ لِلْعَرْضِ.",
      "visual": {
        "type": "title",
        "kicker": "اختبار",
        "headline": "حالات حدية",
        "sub": "عرض قصير"
