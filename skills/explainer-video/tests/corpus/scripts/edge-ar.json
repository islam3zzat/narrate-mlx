              "دائم"
            ]
          }
        ]
      }
    },
    {
      "id": "s04",
      "narration": "نُخَطِّطُ لِلْعَمَلِ، ثُمَّ نَبْنِيهِ، ثُمَّ نَنْشُرُهُ.",
      "visual": {
        "type": "steps",
        "heading": "الخطوات",
        "items": [
