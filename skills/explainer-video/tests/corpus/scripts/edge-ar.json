    {
      "id": "s02",
      "narration": "أَوَّلًا نَقْرَأُ الْمُدْخَلَاتِ. ثَانِيًا نَتَحَقَّقُ مِنْهَا. ثَالِثًا نَكْتُبُ النَّتِيجَةَ.",
      "visual": {
        "type": "bullets",
        "heading": "ثلاث نقاط",
        "items": [
          "قراءة المدخلات",
          "التحقق منها",
          "كتابة النتيجة"
        ]
      }
    },
    {
      "id": "s03",
      "narration": "الذَّاكِرَةُ سَرِيعَةٌ وَصَغِيرَةٌ. الْقُرْصُ بَطِيءٌ وَكَبِيرٌ.",
      "visual": {
        "type": "compare",
        "heading": "خياران",
        "columns": [
          {
            "title": "الذاكرة",
            "tag": "سريعة",
