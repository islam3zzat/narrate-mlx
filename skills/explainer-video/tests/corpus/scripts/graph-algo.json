{
  "title": "Animated Graph Algorithms",
  "scenes": [
    {
      "id": "s01",
      "narration": "Start Dijkstra at source S. First visit B and relax edge B A, then settle A to reach C, and lock shortest path T at cost seven.",
      "visual": {
        "type": "graph-algo",
        "heading": "Dijkstra Shortest Path from S to T",
        "directed": true,
        "nodes": [
          {"id": "S", "label": "S", "x": 0.06, "y": 0.5},
          {"id": "A", "label": "A", "x": 0.36, "y": 0.2},
          {"id": "B", "label": "B", "x": 0.36, "y": 0.8},
          {"id": "C", "label": "C", "x": 0.68, "y": 0.2},
          {"id": "T", "label": "T", "x": 0.94, "y": 0.5}
        ],
        "edges": [
          {"id": "SA", "from": "S", "to": "A", "weight": 4},
          {"id": "SB", "from": "S", "to": "B", "weight": 2},
          {"id": "BA", "from": "B", "to": "A", "weight": 1},
          {"id": "AC", "from": "A", "to": "C", "weight": 2},
          {"id": "BC", "from": "B", "to": "C", "weight": 6},
          {"id": "CT", "from": "C", "to": "T", "weight": 2},
          {"id": "BT", "from": "B", "to": "T", "weight": 8}
        ],
        "steps": [
          {
            "id": "init",
            "label": "Start at source S",
            "note": "d(S) = 0",
            "nodeStates": {"S": "active", "A": "frontier", "B": "frontier"},
            "nodeBadges": {"S": "d=0", "A": "d=4", "B": "d=2", "C": "d=inf", "T": "d=inf"},
            "edgeStates": {"SA": "frontier", "SB": "frontier"},
            "aux": {"label": "Priority Q", "items": [{"text": "(2, B)", "tone": "frontier"}, {"text": "(4, A)", "tone": "frontier"}]}
          },
          {
            "id": "popB",
            "label": "Visit B and relax A",
            "note": "2 + 1 < 4",
            "nodeStates": {"S": "sorted", "B": "active", "A": "swap", "C": "frontier", "T": "frontier"},
            "nodeBadges": {"S": "d=0", "B": "d=2", "A": "d=3", "C": "d=8", "T": "d=10"},
            "edgeStates": {"SB": "sorted", "BA": "swap", "BC": "frontier", "BT": "frontier"},
            "aux": {"label": "Priority Q", "items": [{"text": "(3, A)", "tone": "swap"}, {"text": "(8, C)", "tone": "frontier"}]}
          },
          {
            "id": "popA",
            "label": "Settle A to reach C",
            "note": "3 + 2 = 5",
            "nodeStates": {"S": "sorted", "B": "sorted", "A": "active", "C": "swap", "T": "frontier"},
            "nodeBadges": {"S": "d=0", "B": "d=2", "A": "d=3", "C": "d=5", "T": "d=10"},
            "edgeStates": {"SB": "sorted", "BA": "sorted", "AC": "swap", "BT": "dim"},
            "aux": {"label": "Priority Q", "items": [{"text": "(5, C)", "tone": "swap"}, {"text": "(10, T)", "tone": "frontier"}]}
          },
          {
            "id": "doneT",
            "label": "Lock shortest path to T",
            "note": "cost = 7",
            "nodeStates": {"S": "sorted", "B": "sorted", "A": "sorted", "C": "sorted", "T": "pivot"},
            "nodeBadges": {"S": "d=0", "B": "d=2", "A": "d=3", "C": "d=5", "T": "d=7"},
            "edgeStates": {"SB": "sorted", "BA": "sorted", "AC": "sorted", "CT": "sorted", "SA": "dim", "BC": "dim", "BT": "dim"},
            "aux": {"label": "Shortest Path", "items": [{"text": "S -> B -> A -> C -> T", "tone": "sorted"}, {"text": "cost = 7", "tone": "pivot"}]}
          }
        ],
        "caption": "Relaxing edges updates tentative distances along active transitions."
      }
    },
    {
      "id": "s02",
      "narration": "Breadth-first search starts at root S, explores level one neighbors A and B next, and reaches final level two nodes C, D, and E.",
      "focus": [{"at": "final level two", "on": ["C", "D", "E"]}],
      "visual": {
        "type": "graph-algo",
        "heading": "BFS Level Traversal (Auto-Layout)",
        "directed": false,
        "nodes": [
          {"id": "S", "label": "S"},
          {"id": "A", "label": "A"},
          {"id": "B", "label": "B"},
          {"id": "C", "label": "C"},
          {"id": "D", "label": "D"},
          {"id": "E", "label": "E"}
        ],
        "edges": [
          {"from": "S", "to": "A"},
          {"from": "S", "to": "B"},
          {"from": "A", "to": "C"},
          {"from": "A", "to": "D"},
          {"from": "B", "to": "E"},
          {"from": "C", "to": "D"}
        ],
        "steps": [
          {
            "id": "root",
            "label": "Start at root S",
            "nodeStates": {"S": "active"},
            "nodeBadges": {"S": "L0"},
            "aux": {"label": "Queue", "items": [{"text": "S", "tone": "active"}]}
          },
          {
            "id": "lvl1",
            "label": "Explore level one",
            "nodeStates": {"S": "visited", "A": "frontier", "B": "frontier"},
            "nodeBadges": {"S": "L0", "A": "L1", "B": "L1"},
            "edgeStates": {"S->A": "frontier", "S->B": "frontier"},
            "aux": {"label": "Queue", "items": [{"text": "A", "tone": "frontier"}, {"text": "B", "tone": "frontier"}]}
          },
          {
            "id": "lvl2",
            "label": "Reach level two",
            "nodeStates": {"S": "sorted", "A": "visited", "B": "visited", "C": "active", "D": "active", "E": "active"},
            "nodeBadges": {"S": "L0", "A": "L1", "B": "L1", "C": "L2", "D": "L2", "E": "L2"},
            "edgeStates": {"S->A": "visited", "S->B": "visited", "A->C": "active", "A->D": "active", "B->E": "active", "C->D": "dim"},
            "aux": {"label": "Queue", "items": [{"text": "C", "tone": "active"}, {"text": "D", "tone": "active"}, {"text": "E", "tone": "active"}]}
          }
        ],
        "caption": "Without x/y coordinates, BFS layers organize cleanly left to right."
      }
    }
  ]
}
