      "gloss": "Turns similarity logits into non-negative weights summing to one.",
      "tone": "secondary"
     },
     {
      "id": "val",
      "label": "Weighted value",
      "gloss": "Blends value representations proportional to those attention weights.",
      "tone": "primary"
     }
    ],
