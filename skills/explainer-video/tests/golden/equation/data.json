    "heading": "Scaled Dot-Product Attention",
    "equations": [
     {
      "label": "Transformer Layer Core",
      "latex": "\\operatorname{Attention}(Q, K, V) = \\term{soft}{\\operatorname{softmax}}\\!\\left(\\frac{\\term{qk}{Q K^\\top}}{\\term{scale}{\\sqrt{d_k}}}\\right) \\term{val}{V}"
