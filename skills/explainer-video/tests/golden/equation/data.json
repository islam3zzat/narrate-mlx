  {
   "id": "s02",
   "narration": "Bayes rule updates a prior belief with incoming likelihood evidence, then rescales by total evidence so posterior beliefs still sum to one.",
   "visual": {
    "type": "equation",
    "heading": "Posterior Updating with Bayes Rule",
    "equations": [
     {
      "label": "Hypothesis Update",
      "latex": "P(H \\mid E) = \\frac{\\term{lik}{P(E \\mid H)}\\,\\term{prior}{P(H)}}{\\term{evid}{P(E)}}"
     },
     {
      "label": "Total Evidence",
      "latex": "\\term{evid}{P(E)} = \\sum_i P(E \\mid H_i) P(H_i)"
     }
    ],
    "terms": [
     {
      "id": "prior",
      "label": "Prior belief",
      "gloss": "Baseline plausibility assigned to hypothesis H before observing evidence.",
      "tone": "accent"
     },
     {
      "id": "lik",
      "label": "Likelihood evidence",
      "gloss": "How expected the observed data E would be if H were true.",
      "tone": "primary"
     },
     {
      "id": "evid",
      "label": "Total evidence",
      "gloss": "Normalizing probability of E across every competing hypothesis.",
      "tone": "secondary"
     }
    ],
    "caption": "Both equations share the tagged total evidence term cleanly."
   },
